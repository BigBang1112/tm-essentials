<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<LangVersion>14</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="bunit" Version="2.13.3" />
		<PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
		<PackageReference Include="TUnit" Version="1.85.7" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Src\TmEssentials.Razor\TmEssentials.Razor.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- the static web assets of the library, served to the browser tests -->
		<None Include="..\..\Src\TmEssentials.Razor\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Bunit" />
		<!-- bUnit has an obsolete class of the same name, which breaks the code TUnit generates for hooks -->
		<Using Include="TUnit.Core.TestContext" Alias="TestContext" />
	</ItemGroup>

</Project>
