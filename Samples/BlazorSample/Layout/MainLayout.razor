    <ReuNavItem Name="Text" Href="text" IconType="IconType.Draft"></ReuNavItem>
    <ReuNavItem Name="Time" Href="time" IconType="IconType.Results"></ReuNavItem>
    <ReuNavItem Name="Utilities" Href="utilities" IconType="IconType.Folder"></ReuNavItem>
    <ReuNavItem Name="GitHub" Href="https://github.com/BigBang1112/tm-essentials" IconType="IconType.GitHub" IsNavLink="false" IconOnly="true" IconWidth="28" IconHeight="28"></ReuNavItem>
